---
import Gallery from '../components/Gallery.astro';
import PrivacyMap from '../components/PrivacyMap.astro';
import PrivacyPolicy from '../components/PrivacyPolicy.astro';
import Seo from '../components/Seo.astro';
import site from '../data/site.json';
import '../styles/global.css';
import '../styles/polish.css';
import '../styles/privacy.css';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const tel = (number) => `tel:${String(number).replace(/[^\d+]/g, '')}`;
const year = new Date().getFullYear();

const address = site.address;

const mapsUrl =
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;

const typography = [
  ['--font-menu', site.fontMenu],
  ['--font-about', site.fontAbout],
  ['--font-services', site.fontServices],
  ['--font-stats', site.fontStats],
  ['--font-stats-label', site.fontStatsLabel],
  ['--font-contact-title', site.fontContactTitle],
  ['--font-contact', site.fontContact],
  ['--font-footer', site.fontFooter],
];

const typographyStyle = typography
  .map(([name, value]) => {
    const parsed = Number.parseFloat(String(value));
    return Number.isFinite(parsed) && parsed >= 8 && parsed <= 120
      ? `${name}:${parsed}px`
      : '';
  })
  .filter(Boolean)
  .join(';');
---

<!doctype html>
<html lang="pl" style={typographyStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin>
    <Seo />
    <meta name="theme-color" content="#e5e5e5" />
  </head>

  <body id="Start">
    <header class="site-header">
      <div class="shell header-row">
        <a class="brand" href="#Start" aria-label="Stolkor – początek strony">
          <img
          src={`${base}images/logo-480.webp`}
          srcset={`${base}images/logo-480.webp 480w, ${base}images/logo-960.webp 960w`}
          sizes="240px"
          alt="Stolkor"
          width="240"
          height="196"
          fetchpriority="high"
          decoding="async"
        />
        </a>

        <nav class="main-nav" aria-label="Główna nawigacja">
          <a href="#Galeria">Galeria</a>
          <a href="#Kontakt">Kontakt</a>
        </nav>
      </div>

      <div class="header-frame" aria-hidden="true"></div>
    </header>

    <main>
      <h1 class="visually-hidden">Meble na wymiar w Lwówku Śląskim i okolicach – Stolkor</h1>

      <section class="about-section">
        <div class="shell about-grid">
          <div class="about-copy">
            <p>{site.intro}</p>
            <p class="services-line">{site.servicesLine}</p>
          </div>

          <div class="stat">
            <strong>{site.experience}</strong>
            <span>Lat doświadczenia</span>
          </div>

          <div class="stat">
            <strong>{site.customers}</strong>
            <span>Zadowolonych klientów</span>
          </div>
        </div>
      </section>

      <Gallery />

      <section class="contact-section" id="Kontakt">
        <div class="shell contact-content">
          <div class="contact-title-row">
            <h2>Skontaktuj się z nami</h2>
          </div>

          <div class="contact-grid">
            <div class="map-wrap">
              <PrivacyMap />
            </div>

            <address class="contact-details">
              <p class="contact-line company-line">
                <span class="contact-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                    <path d="M7 9h4M7 13h7M16 9h1"></path>
                  </svg>
                </span>
                <span>{site.company.toUpperCase()}</span>
              </p>

              <a
                class="contact-line address-line"
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Otwórz adres w Mapach Google: ${address}`}
              >
                <span class="contact-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z"></path>
                    <circle cx="12" cy="10" r="2.2"></circle>
                  </svg>
                </span>
                <span>{address}</span>
              </a>

              <a class="contact-line" href={tel(site.phoneFurniture)}>
                <span class="contact-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M5.5 3.8 8 3l2 5-2 1.4a15 15 0 0 0 6.6 6.6L16 14l5 2-.8 2.5c-.3 1-1.2 1.7-2.3 1.7C10.2 20.2 3.8 13.8 3.8 6.1c0-1 .7-2 1.7-2.3Z"></path>
                  </svg>
                </span>
                <span>{site.phoneFurniture} - {site.phoneFurnitureLabel}</span>
              </a>

              <a class="contact-line" href={tel(site.phoneJoinery)}>
                <span class="contact-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M5.5 3.8 8 3l2 5-2 1.4a15 15 0 0 0 6.6 6.6L16 14l5 2-.8 2.5c-.3 1-1.2 1.7-2.3 1.7C10.2 20.2 3.8 13.8 3.8 6.1c0-1 .7-2 1.7-2.3Z"></path>
                  </svg>
                </span>
                <span>{site.phoneJoinery} - {site.phoneJoineryLabel}</span>
              </a>

              <p class="contact-note">{site.contactText}</p>
            </address>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell">© {year} {site.copyright}<button type="button" class="privacy-policy-trigger" data-privacy-open>Polityka prywatności</button></div>
    </footer>
    <PrivacyPolicy />
  </body>
</html>