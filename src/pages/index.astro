---
import Gallery from '../components/Gallery.astro';
import site from '../data/site.json';
import '../styles/global.css';
import '../styles/polish.css';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const tel = (number) => `tel:${String(number).replace(/[^\d+]/g, '')}`;
const year = new Date().getFullYear();

const introParagraphs = Array.isArray(site.intro)
  ? site.intro
  : [site.intro].filter(Boolean);

const defaultMapEmbed =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2507.9122663555568!2d15.68809381571674!3d51.054707751521406!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x470f24197deba825%3A0xaed33a3c5b79b973!2sPrze%C5%BAdziedza%201%2C%2059-610%20Prze%C5%BAdziedza!5e0!3m2!1spl!2spl!4v1627841523398!5m2!1spl!2spl';

const mapEmbed = site.mapEmbed || defaultMapEmbed;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#e5e5e5" />
    <title>{site.title}</title>
  </head>

  <body id="Start">
    <header class="site-header">
      <div class="shell header-row">
        <a class="brand" href="#Start" aria-label="Stolkor – początek strony">
          <img
            src={`${base}images/logo.webp`}
            alt="Stolkor"
            width="240"
          />
        </a>

        <nav class="main-nav" aria-label="Główna nawigacja">
          <a href="#Galeria">
            <span aria-hidden="true">›</span>
            Galeria
          </a>

          <a href="#Kontakt">
            <span aria-hidden="true">›</span>
            Kontakt
          </a>
        </nav>
      </div>

      <div class="header-frame" aria-hidden="true"></div>
    </header>

    <main>
      <section class="about-section">
        <div class="shell about-grid">
          <div class="about-copy">
            {introParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <div class="stat">
            <strong>{site.experience}</strong>
            <span>Lat doświadczenia</span>
          </div>

          <div class="stat">
            <strong>{site.customers}</strong>
            <span>Zadowolonych klientów</span>
          </div>
        </div>
      </section>

      <Gallery />

      <section class="contact-section" id="Kontakt">
        <div class="contact-frame" aria-hidden="true">
          <span class="contact-frame-back"></span>
          <span class="contact-frame-mid"></span>
          <span class="contact-frame-front"></span>
        </div>

        <div class="shell contact-content">
          <div class="contact-title-row">
            <h2>Skontaktuj się z nami</h2>
          </div>

          <div class="contact-grid">
            <div class="map-wrap">
              <iframe
                title="Mapa dojazdu do Stolkor"
                src={mapEmbed}
                width="502"
                height="443"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>

            <address class="contact-details">
              <p class="contact-line company-line">
                <span class="contact-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                    <path d="M7 9h4M7 13h7M16 9h1"></path>
                  </svg>
                </span>
                <span>{site.company.toUpperCase()}</span>
              </p>

              <a class="contact-line" href={tel(site.phoneFurniture)}>
                <span class="contact-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M5.5 3.8 8 3l2 5-2 1.4a15 15 0 0 0 6.6 6.6L16 14l5 2-.8 2.5c-.3 1-1.2 1.7-2.3 1.7C10.2 20.2 3.8 13.8 3.8 6.1c0-1 .7-2 1.7-2.3Z"></path>
                  </svg>
                </span>
                <span>{site.phoneFurniture} - {site.phoneFurnitureLabel}</span>
              </a>

              <a class="contact-line" href={tel(site.phoneJoinery)}>
                <span class="contact-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M5.5 3.8 8 3l2 5-2 1.4a15 15 0 0 0 6.6 6.6L16 14l5 2-.8 2.5c-.3 1-1.2 1.7-2.3 1.7C10.2 20.2 3.8 13.8 3.8 6.1c0-1 .7-2 1.7-2.3Z"></path>
                  </svg>
                </span>
                <span>{site.phoneJoinery} - {site.phoneJoineryLabel}</span>
              </a>

              <p class="contact-note">{site.contactText}</p>
            </address>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell">© {year} {site.copyright}</div>
    </footer>
  </body>
</html>
