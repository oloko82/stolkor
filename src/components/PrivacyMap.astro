---
const mapEmbed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2507.9122663555568!2d15.68809381571674!3d51.054707751521406!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x470f24197deba825%3A0xaed33a3c5b79b973!2sPrze%C5%BAdziedza%201%2C%2059-610%20Prze%C5%BAdziedza!5e0!3m2!1spl!2spl!4v1627841523398!5m2!1spl!2spl';
---

<div class="privacy-map" data-privacy-map>
  <div class="privacy-map-placeholder">
    <svg class="privacy-map-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z"></path>
      <circle cx="12" cy="10" r="2.2"></circle>
    </svg>
    <strong>Mapa Google</strong>
    <p>Mapa jest ładowana dopiero po Twoim kliknięciu.</p>
    <button type="button" class="privacy-map-button" data-load-map data-map-src={mapEmbed}>
      Wyświetl mapę
    </button>
    <small>Wyświetlenie mapy powoduje połączenie z usługą Google Maps.</small>
  </div>
</div>

<script>
  document.querySelectorAll('[data-load-map]').forEach((button) => {
    button.addEventListener('click', () => {
      const host = button.closest('[data-privacy-map]');
      const src = button.getAttribute('data-map-src');
      if (!host || !src) return;

      const iframe = document.createElement('iframe');
      iframe.title = 'Mapa dojazdu do Stolkor';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      iframe.src = src;
      host.replaceChildren(iframe);
    }, { once: true });
  });
</script>

