---
import gallery from '../data/gallery.json';
import optimizedManifest from '../data/gallery-optimized.json';
import '../styles/masonry.css';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const withBase = (src) => `${base}${src.replace(/^\//, '')}`;

const items = gallery.images.map((item, index) => {
  const optimized = optimizedManifest.images?.[item.src];

  if (!optimized) {
    return {
      ...item,
      index,
      src: withBase(item.src),
      srcset: undefined,
      width: undefined,
      height: undefined,
      lightbox: withBase(item.src),
    };
  }

  return {
    ...item,
    index,
    src: withBase(optimized.sources['960']),
    srcset: [
      `${withBase(optimized.sources['480'])} 480w`,
      `${withBase(optimized.sources['960'])} 960w`,
      `${withBase(optimized.sources['1600'])} 1600w`,
    ].join(', '),
    width: optimized.width,
    height: optimized.height,
    lightbox: withBase(optimized.sources['1600']),
  };
});
---

<section class="gallery-section" id="Galeria" aria-label="Galeria realizacji">
  <div
    class="masonry"
    data-masonry
    data-masonry-gap="10"
  >
    <div class="masonry-source" data-masonry-source>
      {items.map((item) => (
        <button
          class="gallery-item"
          type="button"
          data-lightbox-index={item.index}
          aria-label={`Otwórz zdjęcie: ${item.alt}`}
        >
          <img
            src={item.src}
            srcset={item.srcset}
            sizes="(max-width: 680px) calc((100vw - 10px) / 2), (max-width: 980px) calc((100vw - 20px) / 3), calc((100vw - 30px) / 4)"
            width={item.width}
            height={item.height}
            alt={item.alt}
            loading={item.index > 5 ? 'lazy' : 'eager'}
            decoding="async"
            fetchpriority={item.index < 4 ? 'high' : 'auto'}
          />
        </button>
      ))}
    </div>

    <div class="masonry-columns" data-masonry-columns></div>
  </div>
</section>

<dialog class="lightbox" id="lightbox">
  <button class="lightbox-close" type="button" aria-label="Zamknij">×</button>
  <button class="lightbox-nav lightbox-prev" type="button" aria-label="Poprzednie zdjęcie">‹</button>
  <img class="lightbox-image" src="" alt="" />
  <button class="lightbox-nav lightbox-next" type="button" aria-label="Następne zdjęcie">›</button>
</dialog>

<script define:vars={{ lightboxItems: items.map(({ alt, lightbox }) => ({ alt, lightbox })) }}>
  const masonry = document.querySelector('[data-masonry]');
  const source = masonry?.querySelector('[data-masonry-source]');
  const columnsHost = masonry?.querySelector('[data-masonry-columns]');
  const gap = Number(masonry?.dataset.masonryGap || 10);

  const dialog = document.querySelector('#lightbox');
  const lightboxImage = dialog?.querySelector('.lightbox-image');

  let current = 0;
  let currentColumnCount = 0;
  let resizeTimer;

  const getColumnCount = () => {
    if (window.innerWidth <= 680) return 2;
    if (window.innerWidth <= 980) return 3;
    return 4;
  };

  const makeColumns = (count) => {
    if (!columnsHost) return [];

    columnsHost.innerHTML = '';
    columnsHost.style.setProperty('--masonry-columns', String(count));
    columnsHost.style.setProperty('--masonry-gap', `${gap}px`);

    return Array.from({ length: count }, () => {
      const column = document.createElement('div');
      column.className = 'masonry-column';
      columnsHost.appendChild(column);
      return column;
    });
  };

  const shortestColumn = (columns) => {
    return columns.reduce((shortest, column) => {
      return column.offsetHeight < shortest.offsetHeight ? column : shortest;
    }, columns[0]);
  };

  const layoutMasonry = (force = false) => {
    if (!source || !columnsHost) return;

    const desiredColumns = getColumnCount();

    if (!force && desiredColumns === currentColumnCount) return;
    currentColumnCount = desiredColumns;

    const existingItems = Array.from(
      masonry.querySelectorAll('.gallery-item')
    );

    existingItems.forEach((item) => source.appendChild(item));

    const columns = makeColumns(desiredColumns);
    const items = Array.from(source.querySelectorAll('.gallery-item'));

    items.forEach((item) => {
      shortestColumn(columns).appendChild(item);
    });

    source.hidden = true;
  };

  const showLightbox = (index) => {
    if (!dialog || !lightboxImage || !lightboxItems.length) return;

    current = (index + lightboxItems.length) % lightboxItems.length;

    lightboxImage.src = lightboxItems[current].lightbox;
    lightboxImage.alt = lightboxItems[current].alt;
  };

  document.addEventListener('click', (event) => {
    const button = event.target.closest?.('[data-lightbox-index]');

    if (!button) return;

    showLightbox(Number(button.dataset.lightboxIndex));
    dialog?.showModal();
  });

  dialog?.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('.lightbox-prev')?.addEventListener('click', () => showLightbox(current - 1));
  dialog?.querySelector('.lightbox-next')?.addEventListener('click', () => showLightbox(current + 1));

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  document.addEventListener('keydown', (event) => {
    if (!dialog?.open) return;

    if (event.key === 'ArrowLeft') showLightbox(current - 1);
    if (event.key === 'ArrowRight') showLightbox(current + 1);
    if (event.key === 'Escape') dialog.close();
  });

  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => layoutMasonry(false), 140);
  });

  layoutMasonry(true);
</script>
